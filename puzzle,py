
from tkinter import Frame, Label, CENTER
import logic
import constants as c


class GameGrid(Frame):
    def __init__(self):
        Frame.__init__(self)

        self.grid()
        self.master.title("2048")
        self.master.bind("<Key>", self.key_down)

        self.score = 0
        self.high_score = 0
        self.history_matrixs = []

        self.commands = {
            c.KEY_UP: logic.up,
            c.KEY_DOWN: logic.down,
            c.KEY_LEFT: logic.left,
            c.KEY_RIGHT: logic.right,
            c.KEY_UP_ALT1: logic.up,
            c.KEY_DOWN_ALT1: logic.down,
            c.KEY_LEFT_ALT1: logic.left,
            c.KEY_RIGHT_ALT1: logic.right,
            c.KEY_UP_ALT2: logic.up,
            c.KEY_DOWN_ALT2: logic.down,
            c.KEY_LEFT_ALT2: logic.left,
            c.KEY_RIGHT_ALT2: logic.right,
        }

        # Score display
        score_frame = Frame(self)
        score_frame.grid(row=0, column=0, pady=10)

        self.score_label = Label(
            score_frame,
            text="Score: 0",
            font=("Verdana", 16, "bold"),
            padx=15
        )
        self.score_label.grid(row=0, column=0)

        self.high_score_label = Label(
            score_frame,
            text="High Score: 0",
            font=("Verdana", 16, "bold"),
            padx=15
        )
        self.high_score_label.grid(row=0, column=1)

        self.grid_cells = []
        self.init_grid()

        self.matrix = logic.new_game(c.GRID_LEN)
        self.update_grid_cells()

        self.mainloop()

    def init_grid(self):
        background = Frame(
            self,
            bg=c.BACKGROUND_COLOR_GAME,
            width=c.SIZE,
            height=c.SIZE
        )
        background.grid(row=1, column=0)

        for i in range(c.GRID_LEN):
            grid_row = []

            for j in range(c.GRID_LEN):
                cell = Frame(
                    background,
                    bg=c.BACKGROUND_COLOR_CELL_EMPTY,
                    width=c.SIZE / c.GRID_LEN,
                    height=c.SIZE / c.GRID_LEN
                )
                cell.grid(
                    row=i,
                    column=j,
                    padx=c.GRID_PADDING,
                    pady=c.GRID_PADDING
                )

                label = Label(
                    master=cell,
                    text="",
                    bg=c.BACKGROUND_COLOR_CELL_EMPTY,
                    justify=CENTER,
                    font=c.FONT,
                    width=5,
                    height=2
                )
                label.grid()
                grid_row.append(label)

            self.grid_cells.append(grid_row)

    def update_scores(self):
        self.score_label.configure(
            text=f"Score: {self.score}"
        )
        self.high_score_label.configure(
            text=f"High Score: {self.high_score}"
        )

    def update_grid_cells(self):
        for i in range(c.GRID_LEN):
            for j in range(c.GRID_LEN):
                new_number = self.matrix[i][j]

                if new_number == 0:
                    self.grid_cells[i][j].configure(
                        text="",
                        bg=c.BACKGROUND_COLOR_CELL_EMPTY
                    )
                else:
                    self.grid_cells[i][j].configure(
                        text=str(new_number),
                        bg=c.BACKGROUND_COLOR_DICT.get(
                            new_number,
                            c.BACKGROUND_COLOR_DICT[2048]
                        ),
                        fg=c.CELL_COLOR_DICT.get(
                            new_number,
                            c.CELL_COLOR_DICT[2048]
                        )
                    )

        self.update_scores()
        self.update_idletasks()

    def key_down(self, event):
        key = event.keysym

        if key == c.KEY_QUIT:
            self.master.destroy()
            return

        # Undo the last successful move
        if key == c.KEY_BACK and self.history_matrixs:
            self.matrix, self.score = self.history_matrixs.pop()
            self.update_grid_cells()
            return

        if key not in self.commands:
            return

        # Save the board and score before moving
        previous_matrix = [row[:] for row in self.matrix]
        previous_score = self.score

        self.matrix, done = self.commands[key](self.matrix)

        if done:
            self.history_matrixs.append(
                (previous_matrix, previous_score)
            )

            self.score += logic.last_move_score
            self.high_score = max(self.high_score, self.score)

            self.matrix = logic.add_two(self.matrix)
            self.update_grid_cells()

            state = logic.game_state(self.matrix)

            if state == "win":
                self.grid_cells[1][1].configure(
                    text="You",
                    bg=c.BACKGROUND_COLOR_CELL_EMPTY
                )
                self.grid_cells[1][2].configure(
                    text="Win!",
                    bg=c.BACKGROUND_COLOR_CELL_EMPTY
                )

            elif state == "lose":
                self.grid_cells[1][1].configure(
                    text="You",
                    bg=c.BACKGROUND_COLOR_CELL_EMPTY
                )
                self.grid_cells[1][2].configure(
                    text="Lose!",
                    bg=c.BACKGROUND_COLOR_CELL_EMPTY
                )


game_grid = GameGrid()
